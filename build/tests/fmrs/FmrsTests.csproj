<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure tests of the FMRS dropped-stage table (DroppedStagesV1), with no KSP, no Unity and
    no kRPC.

        dotnet run -c Release -project build/tests/fmrs/FmrsTests.csproj   (double hyphen)

    It compiles src/Plugins/Fmrs/DroppedStages.cs directly (that file uses System only, so
    the ledger is tested exactly as the plugin compiles it) and replays, event by event,
    what KSP and FMRS do: the first campaign flight of 03/10 16h45 (Jool Hope, one booster
    at stage 4, a second staging that drops nothing commandable), the dres lander (two side
    boosters at stage 6, then the core at stage 5), FMRS's "main vessel changed" swap, a
    separation outside any staging, rows FMRS alone knows, the watch window, a revert, and
    the wire format.

    A folder of its own, beside AttitudeTests.csproj: two SDK projects in one folder would
    share obj/. Exit code 0 means every check passed. build.cmd runs it before the
    solution build.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>KRPC.Bridge.FmrsTests</AssemblyName>
    <RootNamespace>KRPC.Bridge.Fmrs</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BridgeUseStubs>true</BridgeUseStubs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FmrsTests.cs" />
    <Compile Include="..\..\..\src\Plugins\Fmrs\DroppedStages.cs" />
  </ItemGroup>

</Project>
