# Build output
bin/
obj/
dist/

# Release files prepared by hand (zips, release notes): uploaded to the release page, never committed
release_*/

# Worktrees of the working branches, kept inside the repo folder. Untracked, they would make
# the main checkout "dirty" for the build stamp (tools/build_stamp.py).
.worktrees/

# Remembered KSP install, per machine (tools/find_ksp.py)
ksp.path
*.user
*.suo
*.userprefs

# NuGet
packages/
*.nupkg

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Snapshots written by python/probe_ident.py. One flight's measurement, not a fixture.
python/probe_ident.json

# Editors
.vs/
.vscode/
.idea/

# Agent scratch files, recreated on demand and of no use to anyone reading the repo
AGENTS.md
CLAUDE.md
.claude/

# The maintainer's own release runbook: how to tag, what to paste into the SpaceDock
# form, how to open the CKAN pull request. Kept on disk, not published - it is process,
# not documentation, and nobody using the mod needs it.
docs/publishing/

# OS
Thumbs.db
desktop.ini
.DS_Store
